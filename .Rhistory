if (!requireNamespace("tidyverse", quietly = TRUE)) install.packages("tidyverse")
if (!requireNamespace("tools", quietly = TRUE)) install.packages("tools")
library(tidyverse)
library(tools)
# Function to convert a single .rda file to .csv
convert_rda_to_csv <- function(rda_file) {
# Load the .rda file
loaded_data <- load(rda_file)
# Assuming the first loaded object is the data frame we want to convert
data_name <- loaded_data[1]
data <- get(data_name)
if (is.data.frame(data) || is_tibble(data)) {
# Create the output filename
csv_file <- paste0(file_path_sans_ext(rda_file), ".csv")
# Write to CSV
write.csv(data, file = csv_file, row.names = FALSE)
cat(paste("Converted:", rda_file, "to", csv_file, "\n"))
} else {
cat(paste("Skipped:", rda_file, "as it does not contain a data frame.\n"))
}
}
# Get all .rda files in the current directory
rda_files <- list.files(pattern = "*.rda", full.names = TRUE)
# Convert each .rda file to .csv
lapply(rda_files, convert_rda_to_csv)
