# Filter for .rda files
rda_files <- sapply(files, function(file) {
if (grepl("\\.rda$", file$name)) {
return(file$download_url)
}
})
rda_files <- rda_files[!sapply(rda_files, is.null)]
# Download each file
for (url in rda_files) {
filename <- basename(url)
download.file(url, filename, mode = "wb")
cat(paste("Downloaded:", filename, "\n"))
}
